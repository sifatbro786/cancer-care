# ─── Public ──────────────────────────────────────────────
# Canonical site URL (used for metadataBase, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Email (Nodemailer · wired in Phase 4) ───────────────
# Gmail: use an App Password (Google Account → Security → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# Sender shown to recipients, and the clinic inbox that receives enquiries
MAIL_FROM="Adelin Cancer Care <your-account@gmail.com>"
MAIL_TO=care@cancercare.com.bd

# ─── Database (B1) ───────────────────────────────────────
# Set → content is read from MongoDB and form submissions are saved there first.
# Unset → static demo mode: content from data/*.js, forms are email-only.
# After setting it the first time, run:  npm run seed
MONGODB_URI=mongodb://127.0.0.1:27017/cancer-care
# Optional: override the db name in the URI, and the pool size per server process
# MONGODB_DB=cancer-care
# MONGODB_POOL_SIZE=10
# Optional (dev): override DNS if SRV lookup fails → querySrv ECONNREFUSED
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# ─── Admin auth (B2) ─────────────────────────────────────
# Signs the admin session cookie. REQUIRED for /admin. ≥32 random chars; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it signs every admin out. First admin:  npm run create-admin -- --email you@x.com --name "Your Name"
AUTH_SECRET=

# ─── Online payments (medicine shop) ─────────────────────
# A gateway switches on as soon as its keys are filled in (and MONGODB_URI is set).
# Empty → the shop offers only "Pay later" (cash on delivery / at the chamber).
# After changing these: npm run build, then restart the app (the shop pages are prerendered).
# Callbacks use NEXT_PUBLIC_SITE_URL — it must be the public https:// address:
#   bKash → {SITE}/api/payment/bkash/callback   ·   Nagad → {SITE}/api/payment/nagad/callback

# bKash Tokenized Checkout — credentials from bKash (merchant onboarding email)
# Sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta   Live: https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Nagad Online Payment — Nagad must whitelist the SERVER's public IP and callback URL
# Sandbox: http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0   Live: https://api.mynagad.com
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
# Keys as given by Nagad: bare base64 on one line, or PEM with \n for line breaks
NAGAD_PG_PUBLIC_KEY=
NAGAD_MERCHANT_PRIVATE_KEY=

# ─── Public media (admin uploads, B3) ────────────────────
# Uploaded site photos (WebP). Served at /media/... — default ./storage/media (git-ignored).
# MEDIA_DIR=/var/lib/cancer-care/media
