# ─── Public ──────────────────────────────────────────────
# Canonical site URL (used for metadataBase, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Email (Nodemailer · wired in Phase 4) ───────────────
# Gmail: use an App Password (Google Account → Security → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# Sender shown to recipients, and the clinic inbox that receives enquiries
MAIL_FROM="Cancer Care <your-account@gmail.com>"
MAIL_TO=care@cancercare.com.bd

# ─── Database (B1) ───────────────────────────────────────
# Set → content is read from MongoDB and form submissions are saved there first.
# Unset → static demo mode: content from data/*.js, forms are email-only.
# After setting it the first time, run:  npm run seed
MONGODB_URI=mongodb://127.0.0.1:27017/cancer-care
# Optional: override the db name in the URI, and the pool size per server process
# MONGODB_DB=cancer-care
# MONGODB_POOL_SIZE=10

# ─── Private file storage (prescriptions) ────────────────
# Outside /public — never served statically. Use an absolute path on the VPS and back it up.
# PRIVATE_STORAGE_DIR=/var/lib/cancer-care/storage
